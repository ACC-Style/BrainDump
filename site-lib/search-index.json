n/future-of-ux-presentation.html"},"287":{"title":"Project Description","aliases":[],"headers":[],"tags":[],"path":"work/acc/projects/algorithm/project-description.html"},"288":{"title":"Algorithm Design System","aliases":[],"headers":["Project Summary","Hypothesis","Work Outline","Notes"],"tags":["#project"],"path":"work/acc/projects/algorithm-design-system.html"},"289":{"title":"Awards Distinguished","aliases":[],"headers":["Project Summary","Hypothesis","Work Outline","Notes"],"tags":["#project"],"path":"work/acc/projects/awards-distinguished.html"},"290":{"title":"UI List of Objects","aliases":[],"headers":["UI Elements"],"tags":["#project"],"path":"work/acc/projects/member-sections/ui-list-of-objects.html"},"291":{"title":"Onboarding Dynamic Content","aliases":[],"headers":["Project Summary","UI Framework for Exclusive Member Benefit Access","Overview","Document Outline by UI Sections and User States","UI Sections","User States","Content Template","General Introduction (Evergreen)","Logged Out State (Not Evergreen)","General Introduction","Primary CTA","Footer Echoed CTA","Logged In, Not a Member (Not Evergreen)","General Introduction","Primary CTA","Footer Echoed CTA","Logged In Member, Not Part of the Section (Not Evergreen)","General Introduction","Primary CTA","Footer Echoed CTA","In-depth Sections","Logged In Member, Not Part of the Section"],"tags":[],"path":"work/acc/projects/member-sections/content-docs/onboarding-dynamic-content.html"},"292":{"title":"AMA -- American Medical Association","aliases":[],"headers":["American Medical Association (<a rel=\"noopener nofollow\" class=\"external-link\" href=\"https://www.ama-assn.org/\" target=\"_blank\">https://www.ama-assn.org/</a>)","Main Site vs. Journal Site","Integration of Experience (X-Axis)","Content Overlap (Y-Axis)","Membership Experience","Brand Personality","Strategic Emphasis on Organizational Initiatives","Radial Chart","Additional Notes","Art Direction","UX Warning"],"tags":[],"path":"work/acc/projects/acc-redesign/discovery/associations/ama-american-medical-association.html"},"293":{"title":"Metric Responses to Word Doc","aliases":[],"headers":["1. Scientific Journals:","Do they have sperate sites? How do the sites fit together?&nbsp; Do they share branding?&nbsp; How does content flow or repeat between sites?","How are users traveling between main site and journal sites?","2. Events:&nbsp;How are they presented, and&nbsp;How are events supported?","4. Membership: How prominent is their membership / join information? Is it a separate site? Does the page look different for users who are current members?","5. Donations:&nbsp;Are donations a prominent part of the site?","6. Networking:&nbsp; Are there digital elements/platforms available to assist with networking?","7. Latest science/clinical trials:&nbsp;How to these sites feature the latest science? Feeds?&nbsp;Do they have editorial content about the science or just the articles?","8. Paywall:","Is content completely hidden/ 3 free articles / fuzzed out sections, etc. (Metered, hard, freemium) How much content can they see for free?&nbsp; Is that a different type of information than what’s behind the paywall?","9. How is the incentive to log in if you have an account balanced with making some information accessible?","10. Education:&nbsp; Learning Catalog – are products separate from membership products?&nbsp; Is there one “store” for any purchases?","11. For organizations with multiples sites, how does the brand stretch across platforms?","12. Do the offer content for patients? How do they integrate that with the content for clinicians"],"tags":[],"path":"work/acc/projects/acc-redesign/discovery/metric-responses-to-word-doc.html"},"294":{"title":"Ad Usage","aliases":[],"headers":[],"tags":[],"path":"work/acc/projects/acc-redesign/discovery/data/ad-usage.html"},"295":{"title":"Pasted image 20250514093947","aliases":[],"headers":[],"tags":[],"path":"_pastedimages/pasted-image-20250514093947.html"},"296":{"